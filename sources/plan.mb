morning-pills/
├── maps/              # Карты (.wad, .dbs)
│   └── MAP01.wad
├── zscript/           # Скрипты (.zs)
│   ├── mobs/          # Монстры
│   │   └── andrey.zs
│   ├── weapons/       # Оружие
│   └── decorations/   # Объекты (декор)
├── sprites/           # Спрайты (.png)
│   ├── mobs/          # Спрайты монстров
│   ├── weapons/       # Спрайты оружия
│   └── hud/           # Спрайты интерфейса
├── sounds/            # Звуки (.ogg)
│   ├── mobs/          # Звуки монстров
│   ├── weapons/       # Звуки оружия
│   └── ambient/       # Эмбиент, шаги, шёпот
├── music/             # Музыка (.ogg)
├── textures/          # Текстуры (.png + TEXTURES.txt)
├── graphics/          # HUD, TITLEPIC, лого
├── fonts/             # Шрифты 
├── README.md          # Описание, лицензия, warning
├── .gitignore         # Мусор (autosave, backup)
└── build.sh           # Скрипт сборки .pk3
