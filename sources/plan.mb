morning-pills/
├── maps/              # Maps (.wad, .dbs)
│   └── MAP01.wad
├── zscript/           # Scripts (.zs)
│   ├── mobs/          # Monsters
│   │   └── andrey.zs
│   ├── weapons/       # Weapons
│   └── decorations/   # Objects (decor)
├── sprites/           # Sprites (.png)
│   ├── mobs/          # Monster sprites
│   ├── weapons/       # Weapon sprites
│   └── hud/           # Interface sprites
├── sounds/            # Sounds (.ogg)
│   ├── mobs/          # Monster sounds
│   ├── weapons/       # Weapon sounds
│   └── ambient/       # Ambient, footsteps, whispers
├── music/             # Music (.ogg)
├── textures/          # Textures (.png + TEXTURES.txt)
├── graphics/          # HUD, TITLEPIC, logo
├── fonts/             # Fonts
├── README.md          # Description, license, warnings
├── .gitignore         # Junk files (autosave, backup)
└── build.sh           # .pk3 build script
